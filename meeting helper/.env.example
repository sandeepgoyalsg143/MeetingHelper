# SAP settings belong only on the hosted server. Never include these in an end-user package.
SAP_AI_CORE_BASE_URL=
SAP_AI_CORE_CLIENT_ID=
SAP_AI_CORE_CLIENT_SECRET=
SAP_AI_CORE_TOKEN_URI=
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_MODEL=gemini-3.5-flash
SAP_AI_CORE_DEPLOYMENT_ID=

# Hosted server settings. Use managed PostgreSQL and strong random tokens.
HOSTED_MODE=0
PORT=3000
DATABASE_URL=
ADMIN_TOKEN=

# End-user desktop setting. Keep SAP credentials out of this file.
MEETING_HELPER_API_URL=
SERVER_TOKEN=