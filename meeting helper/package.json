{
  "name": "meeting-helper",
  "version": "1.4.5",
  "private": true,
  "description": "Windows private meeting assistant with Gemini through SAP AI Core",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server/run-local.js",
    "build:compute": "bun build prisma-compute/server-entry.ts --target=bun --outfile=dist/meeting-helper-api.mjs",
    "check:compute": "tsc --noEmit -p tsconfig.json",
    "test": "node --test",
    "check": "node scripts/check.js",
    "verify:sap": "node scripts/verify-sap.js",
    "test:ui": "electron . --smoke-test",
    "test:overlay": "electron . --overlay-smoke-test",
    "package:win": "electron-builder --win portable"
  },
  "dependencies": {
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@prisma/composer": "^0.39.0",
    "@prisma/composer-prisma-cloud": "^0.39.0",
    "@types/bun": "^1.4.4",
    "arktype": "^2.2.10",
    "bun": "^1.4.4",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "prisma": "8.0.0-rc.34",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "local.meetinghelper.desktop",
    "productName": "Meeting Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "config/**/*",
      "desktop/**/*",
      "server/**/*",
      "scripts/desktop-smoke.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
